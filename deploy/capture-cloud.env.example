# Add these settings to /etc/cold-rolling/capture.env. Keep that file mode 0600.
# Obtain this key from Alibaba Cloud Model Studio; it is not the ECS AccessKey.
CAPTURE_OCR_API_KEY=
CAPTURE_OCR_MODEL=qwen-vl-ocr-2025-11-20
CAPTURE_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Private bucket, standard storage, US (Virginia), local redundancy, pay as you go.
# Install backend/requirements-capture-oss.txt before enabling OSS.
CAPTURE_OSS_BUCKET=
CAPTURE_OSS_REGION=us-east-1
CAPTURE_OSS_ENDPOINT=https://oss-us-east-1-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, when using temporary credentials:
OSS_SESSION_TOKEN=
