[Unit]
Description=Back up cold rolling capture database
After=cold-rolling-capture.service

[Service]
Type=oneshot
User=cold-rolling
Group=cold-rolling
WorkingDirectory=/opt/cold-rolling/current
EnvironmentFile=/etc/cold-rolling/capture.env
ExecStart=/opt/cold-rolling/current/.venv/bin/python -m backend.app.capture_backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cold-rolling/capture
MemoryMax=256M
TimeoutStartSec=180
