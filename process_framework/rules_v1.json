{
  "schema_version": "cold-rolling-process-framework-rules-v1",
  "framework_version": "process-framework-v0.1-draft",
  "status": "draft_requires_process_owner_approval",
  "purpose": "Use standards, equipment limits and approved plant practice to decide which DAT segments may become parameter-model labels. DAT observations are evidence, not ground truth.",
  "principles": {
    "dat_is_not_ground_truth": true,
    "rules_precede_model_training": true,
    "production_auto_apply": false,
    "rolling_force_is_monitoring_not_operator_setpoint": true,
    "gap_recommendation_uses_high_speed_stable_segments_only": true,
    "flatness_is_runtime_feedback_until_units_orientation_and_delay_are_confirmed": true,
    "out_of_scope_prediction_must_be_rejected": true
  },
  "authority_hierarchy": [
    {
      "level": "L0",
      "name": "mandatory_safety",
      "conflict_policy": "always_wins"
    },
    {
      "level": "L1",
      "name": "product_material_temper_and_heat_treatment_standards",
      "conflict_policy": "wins_over_equipment_practice_and_data"
    },
    {
      "level": "L2",
      "name": "approved_mill_and_furnace_capability",
      "conflict_policy": "wins_over_local_heuristics_and_data"
    },
    {
      "level": "L3",
      "name": "process_owner_approved_plant_rules",
      "conflict_policy": "wins_over_statistical_patterns"
    },
    {
      "level": "L4",
      "name": "dat_empirical_evidence",
      "conflict_policy": "may_only_refine_within_L0_to_L3_envelope"
    }
  ],
