  "unit_definitions": {
    "thickness": "mm",
    "width": "mm",
    "total_tension_hmi": "T (metric tonne-force as displayed by HMI)",
    "unit_tension": "kN/mm²",
    "unit_tension_formula": "q_kN_per_mm2 = 9.80665 * total_tension_T / (width_mm * local_thickness_mm)",
    "rolling_force": "T per HMI/DAT channel naming",
    "flatness": "native DAT value; engineering unit not yet confirmed"
  },
  "data_grade_policy": {
    "A": "gold candidate: technically complete, stable, structurally valid and within all currently enforceable gates; process-owner approval is still required before training",
    "B": "review candidate: usable observation with one or more soft-rule warnings, incomplete flatness evidence or provisional-quality warning",
    "C": "process anomaly: raw data remains useful for risk or rejection modelling but must not be a parameter target",
    "D": "corrupt or incomplete record: exclude from parameter and risk modelling",
    "require_human_gold_approval": true,
    "model_training_grades_after_approval": [
      "A"
    ],
    "risk_training_grades": [
      "C"
    ]
  },
  "audit_thresholds": {
    "minimum_high_speed_samples": {
      "value": 120,
      "unit": "samples_at_1Hz",
      "authority_level": "L3",
      "status": "provisional_data_quality_gate"
    },
    "gold_exit_error_abs_p95_ratio": {
      "value": 0.01,
      "unit": "fraction_of_target_exit_thickness",
      "authority_level": "L3",
      "status": "provisional_until_product_tolerance_table_is_linked"
    },
    "maximum_exit_error_abs_p95_ratio_for_parameter_target": {
      "value": 0.015,
      "unit": "fraction_of_target_exit_thickness",
      "authority_level": "L3",
      "status": "provisional_until_product_tolerance_table_is_linked"
    },
    "entry_actual_deviation_review_ratio": {
      "value": 0.05,
      "unit": "fraction_of_entry_set_thickness",
